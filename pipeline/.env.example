# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_REFERENCE=dermatlas-reference-atlas
GCS_PREFIX_REFERENCE=reference

# SQL (optional for now)
USE_CLOUD_SQL=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dermatlas
DB_USER=postgres
DB_PASS=postgres

# If you're using Cloud SQL Auth Proxy later, you'll keep DB_HOST=127.0.0.1
# and run the proxy to expose local 127.0.0.1:5432.