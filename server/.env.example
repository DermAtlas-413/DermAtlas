# Copy relevant section to .env and fill in secrets.
ENV=development
DEBUG=true

# Direct connection (development/testing)
DATABASE_URL=postgresql+asyncpg://dermatlas:dermatlas@localhost:5432/dermatlas_dev

# Cloud SQL connector (staging/production) - use instead of DATABASE_URL
USE_CLOUD_SQL_CONNECTOR=false
CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-project:region:instance
PGUSER=
PGPASSWORD=
PGDATABASE=

# Google Cloud Platform
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
VERTEX_AI_INDEX_ENDPOINT=

# ML model artifacts — paths within GCS_ML_BUCKET (defaults match training output)
GCS_ML_BUCKET=dermatlas-ml-data
MLP_MODEL_GCS_PATH=processed/mlp_final.pt
MLP_CONFIG_GCS_PATH=processed/mlp_config.json
XGB_MODEL_GCS_PATH=processed/xgboost_model.json
XGB_THRESHOLD_GCS_PATH=processed/xgb_threshold.json
XGB_ENCODER_GCS_PATH=processed/xgb_encoder.json

# CORS — comma-separated list of allowed frontend origins.
# Required for ENV=staging and ENV=production. Leave empty for development/testing.
# Example: https://dermatlas.netlify.app,https://staging--dermatlas.netlify.app
ALLOWED_ORIGINS=
